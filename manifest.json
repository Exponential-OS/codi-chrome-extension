{
  "manifest_version": 3,
  "name": "Co-Dialectic",
  "short_name": "Co-Dialectic",
  "version": "0.1.0",
  "description": "LLM prompt optimizer + hallucination detector across AI chat web apps. Sharpens vague prompts, flags fabricated citations, audits sycophancy. Free, open source, on-device.",
  "author": "Anand Vallamsetla",
  "homepage_url": "https://thewhyman.com",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Co-Dialectic",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "optional_permissions": [],

  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://claude.com/*",
    "*://gemini.google.com/*",
    "*://www.perplexity.ai/*",
    "*://perplexity.ai/*",
    "*://poe.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://claude.com/*",
        "*://gemini.google.com/*",
        "*://www.perplexity.ai/*",
        "*://perplexity.ai/*",
        "*://poe.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://claude.com/*",
        "*://gemini.google.com/*",
        "*://www.perplexity.ai/*",
        "*://perplexity.ai/*",
        "*://poe.com/*"
      ]
    }
  ],

  "minimum_chrome_version": "120"
}
